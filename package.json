{
  "name": "music_player",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src && stylelint 'src/**/*.{css,scss}'",
    "test": "vitest",
    "css:audit": "mkdir -p /tmp/purgecss && purgecss --css src/style.css --content 'index.html' 'src/**/*.{jsx,js,ts,tsx}' --output /tmp/purgecss && cat /tmp/purgecss/style.css"
  },
  "dependencies": {
    "buffer": "^6.0.3",
    "idb-keyval": "^6.2.2",
    "music-metadata-browser": "^2.5.11",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "vitest": "^0.34.6",
    "@testing-library/react": "^14.2.1",
    "@testing-library/jest-dom": "^6.1.5",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.2",
    "stylelint": "^16.2.0",
    "stylelint-config-standard": "^35.0.0",
    "purgecss": "^5.0.0",
    "jsdom": "^22.1.0",
    "vite": "^5.0.0"
  }
}
